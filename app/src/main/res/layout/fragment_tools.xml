<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:paddingBottom="112dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
        <!--  Header: title + settings  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/tools_title" android:textColor="@color/screen_text" android:textSize="24sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/btnSettings" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_white" android:contentDescription="@string/settings" android:elevation="2dp" android:padding="10dp" android:src="@drawable/home_ic_settings"/>
        </LinearLayout>
        <!--  Street View card  -->
        <LinearLayout android:id="@+id/cardStreetView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/tools_bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tools_street_view" android:textColor="@color/screen_text" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/tools_street_view_subtitle" android:textColor="@color/screen_text_muted" android:textSize="13sp"/>
                <LinearLayout android:id="@+id/btnExploreStreets" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginTop="12dp" android:background="@drawable/bg_btn_primary" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tools_explore_streets" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="6dp" android:importantForAccessibility="no" android:src="@drawable/home_ic_arrow" android:tint="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="124dp" android:layout_marginStart="10dp" android:layout_weight="1">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tools_bg_street_img" android:clipToOutline="true" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/tools_street_view"/>
                <ImageButton android:id="@+id/btnExpandStreet" android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="@drawable/home_bg_circle_glass" android:contentDescription="@string/expand" android:padding="8dp" android:src="@drawable/home_ic_expand" android:tint="@color/home_navy"/>
                <!--  "360 View" pill  -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="8dp" android:background="@drawable/tools_bg_pill" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="8dp" android:paddingVertical="4dp">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:importantForAccessibility="no" android:src="@drawable/home_ic_location" android:tint="@color/home_icon_dark"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="@string/tools_view_360" android:textColor="@color/home_icon_dark" android:textSize="11sp"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <!--  Famous Places header  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/tools_famous_places" android:textColor="@color/screen_text" android:textSize="17sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvSeeAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:padding="4dp" android:text="@string/tools_see_all" android:textColor="@color/screen_primary" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <!--  Famous Places: 4 round images  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/placeNature" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:layout_width="74dp" android:layout_height="74dp" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/tools_place_nature"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/tools_place_nature" android:textColor="@color/screen_text" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/placeHistoric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:layout_width="74dp" android:layout_height="74dp" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/tools_place_historic"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/tools_place_historic" android:textColor="@color/screen_text" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/placeCity" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:layout_width="74dp" android:layout_height="74dp" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/tools_place_city"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/tools_place_city" android:textColor="@color/screen_text" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/placeBeaches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:layout_width="74dp" android:layout_height="74dp" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/tools_place_beaches"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/tools_place_beaches" android:textColor="@color/screen_text" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
        <!--  Travel tools  -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/tools_travel_tools" android:textColor="@color/screen_text" android:textSize="17sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <!--  GPS Camera (tall card)  -->
            <FrameLayout android:id="@+id/cardCamera" android:layout_width="0dp" android:layout_height="204dp" android:layout_weight="1" android:background="@drawable/tools_bg_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:layout_width="100dp" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="14dp" android:layout_marginEnd="14dp" android:adjustViewBounds="true" android:importantForAccessibility="no" android:src="@drawable/tools_ic_camera"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tools_gps_camera" android:textColor="@color/screen_text" android:textSize="17sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginEnd="46dp" android:text="@string/tools_gps_camera_subtitle" android:textColor="@color/screen_text_muted" android:textSize="12sp"/>
                </LinearLayout>
                <ImageView android:id="@+id/btnCameraGo" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="bottom|end" android:layout_marginEnd="12dp" android:layout_marginBottom="12dp" android:background="@drawable/home_bg_circle_blue" android:contentDescription="@string/tools_gps_camera" android:padding="11dp" android:src="@drawable/home_ic_arrow" android:tint="#FFFFFF"/>
            </FrameLayout>
            <!--  Compass + Saved Parking (stacked)  -->
            <LinearLayout android:layout_width="0dp" android:layout_height="204dp" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <FrameLayout android:id="@+id/cardCompass" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/tools_bg_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                    <ImageView android:layout_width="50dp" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="8dp" android:layout_marginEnd="10dp" android:adjustViewBounds="true" android:importantForAccessibility="no" android:src="@drawable/tools_ic_compass"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tools_compass" android:textColor="@color/screen_text" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tools_compass_subtitle" android:textColor="@color/screen_text_muted" android:textSize="12sp"/>
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout android:id="@+id/cardParking" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:background="@drawable/tools_bg_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                    <ImageView android:layout_width="46dp" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="10dp" android:layout_marginEnd="10dp" android:adjustViewBounds="true" android:importantForAccessibility="no" android:src="@drawable/tools_ic_parking"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tools_saved_parking" android:textColor="@color/screen_text" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tools_saved_parking_subtitle" android:textColor="@color/screen_text_muted" android:textSize="12sp"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>