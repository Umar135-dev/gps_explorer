<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pro_screen"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Close -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Close"
                android:elevation="2dp"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <!-- Globe + PRO badge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/ivEarth"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_earth_pro" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="70dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_pro_badge"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:rotation="-8"
                android:text="PRO"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Heading: "Explore Like a " + blue "Pro" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore Like a "
                android:textColor="@color/screen_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTitleAccent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pro"
                android:textColor="@color/screen_primary"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="More freedom for every journey."
            android:textColor="@color/screen_text_muted"
            android:textSize="16sp" />

        <!-- Comparison table -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/tableCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_table_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="5"
                        android:gravity="center"
                        android:letterSpacing="0.05"
                        android:text="FEATURES"
                        android:textColor="@color/screen_text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2.2"
                        android:gravity="center"
                        android:letterSpacing="0.05"
                        android:text="BASIC"
                        android:textColor="@color/screen_text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.9"
                        android:background="@drawable/bg_pro_cell"
                        android:gravity="center"
                        android:letterSpacing="0.05"
                        android:text="PRO"
                        android:textColor="@color/screen_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 1 -->
                <LinearLayout style="@style/ProRow">

                    <LinearLayout style="@style/ProFeature">

                        <ImageView
                            style="@style/ProIcon"
                            android:src="@drawable/ic_map" />

                        <TextView
                            style="@style/ProName"
                            android:text="Live Earth Map" />
                    </LinearLayout>
                    <LinearLayout style="@style/ProBasic">
                        <ImageView style="@style/ProCheck" />
                    </LinearLayout>
                    <LinearLayout style="@style/ProPro">
                        <ImageView style="@style/ProCheck" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout style="@style/ProRow">
                    <LinearLayout style="@style/ProFeature">
                        <ImageView style="@style/ProIcon" android:src="@drawable/ic_route" />
                        <TextView style="@style/ProName" android:text="Route Finder" />
                    </LinearLayout>
                    <LinearLayout style="@style/ProBasic">
                        <ImageView style="@style/ProCheck" />
                    </LinearLayout>
                    <LinearLayout style="@style/ProPro">
                        <ImageView style="@style/ProCheck" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout style="@style/ProRow">
                    <LinearLayout style="@style/ProFeature">
                        <ImageView style="@style/ProIcon" android:src="@drawable/ic_calendar" />
                        <TextView style="@style/ProName" android:text="AI Trip Planner" />
                    </LinearLayout>
                    <LinearLayout style="@style/ProBasic">
                        <TextView style="@style/ProCellText" android:text="Limited" />
                    </LinearLayout>
                    <LinearLayout style="@style/ProPro">
                        <TextView
                            style="@style/ProCellText"
                            android:text="More plans"
                            android:textColor="@color/screen_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout style="@style/ProRow">
                    <LinearLayout style="@style/ProFeature">
                        <ImageView style="@style/ProIcon" android:src="@drawable/ic_block" />
                        <TextView style="@style/ProName" android:text="Ad-Free Experience" />
                    </LinearLayout>
                    <LinearLayout style="@style/ProBasic">
                        <TextView style="@style/ProCellText" android:text="—" />
                    </LinearLayout>
                    <LinearLayout style="@style/ProPro">
                        <ImageView style="@style/ProCheck" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 5 -->
                <LinearLayout style="@style/ProRow">
                    <LinearLayout style="@style/ProFeature">
                        <ImageView style="@style/ProIcon" android:src="@drawable/ic_camera" />
                        <TextView style="@style/ProName" android:text="GPS Camera &amp; Compass" />
                    </LinearLayout>
                    <LinearLayout style="@style/ProBasic">
                        <ImageView style="@style/ProCheck" />
                    </LinearLayout>
                    <LinearLayout style="@style/ProPro">
                        <ImageView style="@style/ProCheck" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout> <!-- end of tableCard -->

            <!-- "Save 50%" badge sits on top of the table's upper edge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginEnd="94dp"
                android:background="@drawable/bg_save_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Save 50%"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Pushes price + button to the bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOldPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PKR 7500"
                android:textColor="@color/screen_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="$6.99/week"
                android:textColor="@color/screen_text_muted"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Continue with Pro"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Auto-renewable • Cancel anytime"
            android:textColor="@color/screen_text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Terms of Use"
                android:textColor="@color/screen_primary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•"
                android:textColor="@color/screen_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Privacy Policy"
                android:textColor="@color/screen_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRestore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:padding="4dp"
            android:text="Restore Purchases"
            android:textColor="@color/screen_primary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>