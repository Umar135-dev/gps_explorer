<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Faded mountains at the bottom -->
    <ImageView
        android:id="@+id/ivMountains"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:alpha="0.7"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/img_mountains"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Centered content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <ImageView
            android:id="@+id/ivGlobe"
            android:layout_width="280dp"
            android:layout_height="260dp"
            android:contentDescription="GPS Explore globe"
            android:scaleType="fitCenter"
            android:src="@drawable/img_globe" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/lobster_two_bold_italic"
            android:shadowColor="@color/splash_title_shadow"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="1"
            android:text="GPS Explore"
            android:textColor="@color/splash_title"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/outfit_regular"
            android:text="Your world, your way."
            android:textColor="@color/splash_tagline"
            android:textSize="18sp" />

        <!-- Page-style dots -->
        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/dot1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="6dp" android:importantForAccessibility="no" android:src="@drawable/dot_inactive" />
            <ImageView android:id="@+id/dot2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="6dp" android:importantForAccessibility="no" android:src="@drawable/dot_inactive" />
            <ImageView android:id="@+id/dot3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="6dp" android:importantForAccessibility="no" android:src="@drawable/dot_active" />
            <ImageView android:id="@+id/dot4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="6dp" android:importantForAccessibility="no" android:src="@drawable/dot_inactive" />
            <ImageView android:id="@+id/dot5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="6dp" android:importantForAccessibility="no" android:src="@drawable/dot_inactive" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/outfit_regular"
        android:text="This action may contain ads"
        android:textColor="@color/splash_footer"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>