<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/screen_bg" android:orientation="vertical">
    <!--  Top bar: back + title  -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="start|center_vertical" android:background="@drawable/bg_circle_white" android:contentDescription="@string/settings_back" android:elevation="2dp" android:src="@drawable/ic_back"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/settings" android:textColor="@color/screen_text" android:textSize="18sp" android:textStyle="bold"/>
    </FrameLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="16dp">
            <!--  GPS Pro banner (the two side notches are drawn on top of the card)  -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="8dp" android:clipChildren="false">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/settings_bg_banner" android:clipToOutline="true">
                    <ImageView android:layout_width="230dp" android:layout_height="wrap_content" android:layout_gravity="end|bottom" android:adjustViewBounds="true" android:importantForAccessibility="no" android:src="@drawable/settings_banner_compass"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="start" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/settings_bg_badge" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="@string/settings_banner_badge" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/settings_banner_title" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
                        <LinearLayout android:id="@+id/btnUnlockPro" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginTop="14dp" android:background="@drawable/settings_bg_btn_white" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_unlock_pro" android:textColor="@color/screen_primary" android:textSize="15sp" android:textStyle="bold"/>
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/home_ic_arrow" android:tint="@color/screen_primary"/>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
                <View android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="-9dp" android:background="@drawable/settings_bg_notch"/>
                <View android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="-9dp" android:background="@drawable/settings_bg_notch"/>
            </FrameLayout>
            <!--  Preferences  -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginTop="18dp" android:text="@string/settings_preferences" android:textColor="@color/screen_text_muted" android:textSize="14sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/settings_bg_card" android:orientation="vertical" android:paddingVertical="2dp">
                <LinearLayout android:id="@+id/rowLanguage" android:layout_width="match_parent" android:layout_height="58dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/settings_bg_icon" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/settings_ic_globe"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/settings_app_language" android:textColor="@color/screen_text" android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvLanguageValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/screen_text_muted" android:textSize="14sp"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/settings_ic_chevron"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/rowNotifications" android:layout_width="match_parent" android:layout_height="58dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/settings_bg_icon" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/settings_ic_bell"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/settings_notifications" android:textColor="@color/screen_text" android:textSize="15sp" android:textStyle="bold"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/settings_switch_thumb"
                        app:trackTint="@color/settings_switch_track"
                        app:trackDecorationTint="@color/settings_switch_track" />
                </LinearLayout>
            </LinearLayout>
            <!--  Support & more  -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginTop="16dp" android:text="@string/settings_support" android:textColor="@color/screen_text_muted" android:textSize="14sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/settings_bg_card" android:orientation="vertical" android:paddingVertical="2dp">
                <LinearLayout android:id="@+id/rowHelp" android:layout_width="match_parent" android:layout_height="58dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/settings_bg_icon" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/settings_ic_help"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/settings_help" android:textColor="@color/screen_text" android:textSize="15sp" android:textStyle="bold"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/settings_ic_chevron"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/rowRate" android:layout_width="match_parent" android:layout_height="58dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/settings_bg_icon" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/settings_ic_star"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/settings_rate" android:textColor="@color/screen_text" android:textSize="15sp" android:textStyle="bold"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/settings_ic_chevron"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/rowShare" android:layout_width="match_parent" android:layout_height="58dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/settings_bg_icon" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/settings_ic_share"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/settings_share" android:textColor="@color/screen_text" android:textSize="15sp" android:textStyle="bold"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/settings_ic_chevron"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/rowPrivacy" android:layout_width="match_parent" android:layout_height="58dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/settings_bg_icon" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/settings_ic_shield"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/settings_privacy" android:textColor="@color/screen_text" android:textSize="15sp" android:textStyle="bold"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/settings_ic_chevron"/>
                </LinearLayout>
            </LinearLayout>
            <!--  Pushes the version text to the bottom  -->
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView android:id="@+id/tvVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="16dp" android:gravity="center" android:textColor="@color/screen_text_muted" android:textSize="12sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>