<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:paddingBottom="112dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
        <!--  Header: location + settings  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:id="@+id/btnLocation" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_white" android:elevation="2dp" android:importantForAccessibility="no" android:padding="11dp" android:src="@drawable/home_ic_location" android:tint="@color/screen_primary"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/current_location" android:textColor="@color/screen_text_muted" android:textSize="12sp"/>
                    <TextView android:id="@+id/tvLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_location_placeholder" android:textColor="@color/screen_text" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
            <ImageButton android:id="@+id/btnSettings" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_white" android:contentDescription="@string/settings" android:elevation="2dp" android:padding="10dp" android:src="@drawable/home_ic_settings"/>
        </LinearLayout>
        <!--  Title  -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/home_title" android:textColor="@color/screen_text" android:textSize="26sp" android:textStyle="bold"/>
        <!--  AI search bar  -->
        <LinearLayout android:id="@+id/searchBar" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:background="@drawable/home_bg_search" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:importantForAccessibility="no" android:src="@drawable/home_ic_sparkle" android:tint="@color/home_purple"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="@string/ask_ai_hint" android:textColor="@color/screen_text_muted" android:textSize="15sp"/>
            <ImageView android:id="@+id/btnAskGo" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/home_bg_circle_blue" android:contentDescription="@string/ask_ai" android:padding="11dp" android:src="@drawable/home_ic_arrow" android:tint="#FFFFFF"/>
        </LinearLayout>
        <!--  Live Earth Camera card  -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="392dp" android:layout_marginTop="16dp" android:background="@drawable/home_bg_earth_card" android:clipToOutline="true">
            <!--  Replace grid_* with your real images (earth, NYC, Paris, Rome)  -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/grid_earth"/>
            <View android:layout_width="match_parent" android:layout_height="220dp" android:layout_gravity="bottom" android:background="@drawable/home_bg_earth_overlay"/>
            <!--  Landmark: New York (top centre)  -->
            <FrameLayout android:layout_width="156dp" android:layout_height="84dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="18dp" android:background="@drawable/home_bg_landmark" android:elevation="6dp" android:padding="2dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/home_bg_landmark_img" android:clipToOutline="true" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/grid_city"/>
                <TextView style="@style/HomeLiveBadge" android:layout_gravity="top|start" android:layout_margin="6dp"/>
            </FrameLayout>
            <!--  Landmark: Paris (left)  -->
            <FrameLayout android:layout_width="116dp" android:layout_height="62dp" android:layout_gravity="top|start" android:layout_marginStart="22dp" android:layout_marginTop="139dp" android:background="@drawable/home_bg_landmark" android:elevation="6dp" android:padding="2dp" android:rotation="-8">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/home_bg_landmark_img" android:clipToOutline="true" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/grid_green_road"/>
                <TextView style="@style/HomeLiveBadge" android:layout_gravity="top|start" android:layout_margin="5dp"/>
            </FrameLayout>
            <!--  Landmark: Rome (right)  -->
            <FrameLayout android:layout_width="126dp" android:layout_height="70dp" android:layout_gravity="top|end" android:layout_marginTop="141dp" android:layout_marginEnd="18dp" android:background="@drawable/home_bg_landmark" android:elevation="6dp" android:padding="2dp" android:rotation="8">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/home_bg_landmark_img" android:clipToOutline="true" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/grid_beach_road"/>
                <TextView style="@style/HomeLiveBadge" android:layout_gravity="top|start" android:layout_margin="5dp"/>
            </FrameLayout>
            <!--  Expand button  -->
            <ImageButton android:id="@+id/btnExpand" android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="top|end" android:layout_marginTop="16dp" android:layout_marginEnd="12dp" android:background="@drawable/home_bg_circle_glass" android:contentDescription="@string/expand" android:padding="13dp" android:src="@drawable/home_ic_expand" android:tint="@color/home_navy"/>
            <!--  Bottom text + button  -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/live_earth_title" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/live_earth_subtitle" android:textColor="@color/home_text_on_dark" android:textSize="13sp"/>
                <LinearLayout android:id="@+id/btnExploreEarth" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:background="@drawable/home_bg_btn_white" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/explore_earth" android:textColor="@color/home_navy" android:textSize="16sp" android:textStyle="bold"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/home_ic_arrow" android:tint="@color/home_navy"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <!--  Route Finder card  -->
        <LinearLayout android:id="@+id/routeCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/home_bg_route_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
            <ImageView android:layout_width="104dp" android:layout_height="104dp" android:background="@drawable/home_bg_route_thumb" android:clipToOutline="true" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/grid_map"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/route_finder_title" android:textColor="@color/screen_text" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/route_finder_subtitle" android:textColor="@color/screen_text_muted" android:textSize="14sp"/>
                <LinearLayout android:id="@+id/btnFindRoute" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_btn_primary" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/find_route" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/home_ic_arrow" android:tint="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>