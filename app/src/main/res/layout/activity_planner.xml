<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/home_bg">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:paddingBottom="112dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
            <!--  Header: title + my trips + settings  -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/planner_title" android:textColor="@color/screen_text" android:textSize="24sp" android:textStyle="bold"/>
                <ImageButton android:id="@+id/btnMyTrips" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_white" android:contentDescription="@string/planner_my_trips" android:elevation="2dp" android:padding="11dp" android:src="@drawable/planner_ic_trips"/>
                <ImageButton android:id="@+id/btnSettings" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="12dp" android:background="@drawable/bg_circle_white" android:contentDescription="@string/settings" android:elevation="2dp" android:padding="10dp" android:src="@drawable/home_ic_settings"/>
            </LinearLayout>
            <!--  Hero image (380 x 320 source, scales with screen width)  -->
            <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:adjustViewBounds="true" android:background="@drawable/planner_bg_hero" android:clipToOutline="true" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/planner_hero"/>
            <!--  Headline  -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/planner_headline" android:textColor="@color/screen_text" android:textSize="30sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/planner_subtitle" android:textColor="@color/screen_text_muted" android:textSize="16sp"/>
            <!--  Three feature highlights  -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
                <!--  Thin line running behind the three icon tiles  -->
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="48dp" android:layout_marginTop="25dp" android:background="#DCE6F8"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                        <ImageView android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/planner_bg_feature_tile" android:importantForAccessibility="no" android:padding="11dp" android:src="@drawable/planner_ic_pin"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/planner_feature_places" android:textColor="@color/screen_text" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                        <ImageView android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/planner_bg_feature_tile" android:importantForAccessibility="no" android:padding="11dp" android:src="@drawable/planner_ic_calendar"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/planner_feature_itinerary" android:textColor="@color/screen_text" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                        <ImageView android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/planner_bg_feature_tile" android:importantForAccessibility="no" android:padding="11dp" android:src="@drawable/planner_ic_navigation"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/planner_feature_directions" android:textColor="@color/screen_text" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <!--  Pushes the button toward the bottom on tall screens  -->
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <!--  Main button  -->
            <LinearLayout android:id="@+id/btnPlanTrip" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="28dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_btn_primary" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/planner_plan_my_trip" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/home_ic_arrow" android:tint="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <!--  Bottom navigation + AI button (Planner selected)  -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginHorizontal="16dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:id="@+id/bottomNav" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1" android:background="@drawable/home_bg_bottom_nav" android:elevation="6dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="6dp">
            <!--  Home  -->
            <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/planner_ic_home_outline" android:tint="@color/home_icon_dark"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_home" android:textColor="@color/home_icon_dark" android:textSize="11sp"/>
            </LinearLayout>
            <!--  Planner (selected)  -->
            <LinearLayout android:id="@+id/navPlanner" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/home_bg_nav_selected" android:importantForAccessibility="no" android:padding="7dp" android:src="@drawable/home_ic_planner" android:tint="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_planner" android:textColor="@color/screen_primary" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
            <!--  Tools  -->
            <LinearLayout android:id="@+id/navTools" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/home_ic_tools" android:tint="@color/home_icon_dark"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_tools" android:textColor="@color/home_icon_dark" android:textSize="11sp"/>
            </LinearLayout>
            <!--  Pro  -->
            <LinearLayout android:id="@+id/navPro" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/home_ic_crown" android:tint="@color/home_icon_dark"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_pro" android:textColor="@color/home_icon_dark" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/fabAi" android:layout_width="68dp" android:layout_height="68dp" android:layout_marginStart="10dp" android:background="@drawable/home_bg_fab" android:clickable="true" android:contentDescription="@string/ask_ai" android:elevation="8dp" android:focusable="true" android:padding="20dp" android:src="@drawable/home_ic_sparkle" android:tint="#FFFFFF"/>
    </LinearLayout>
</FrameLayout>