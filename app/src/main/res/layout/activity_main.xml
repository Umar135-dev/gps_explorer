<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/home_bg">
    <!--  Home / Planner fragments are swapped in here  -->
    <androidx.fragment.app.FragmentContainerView android:id="@+id/fragmentContainer" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <!--  Bottom navigation + AI button  -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginHorizontal="16dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:id="@+id/bottomNav" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1" android:background="@drawable/home_bg_bottom_nav" android:elevation="6dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="6dp">
            <!--  Home  -->
            <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/navHomeIcon" android:layout_width="34dp" android:layout_height="34dp" android:importantForAccessibility="no" android:padding="6dp" android:src="@drawable/home_ic_home"/>
                <TextView android:id="@+id/navHomeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_home" android:textSize="11sp"/>
            </LinearLayout>
            <!--  Planner  -->
            <LinearLayout android:id="@+id/navPlanner" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/navPlannerIcon" android:layout_width="34dp" android:layout_height="34dp" android:importantForAccessibility="no" android:padding="6dp" android:src="@drawable/home_ic_planner"/>
                <TextView android:id="@+id/navPlannerLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_planner" android:textSize="11sp"/>
            </LinearLayout>
            <!--  Tools  -->
            <LinearLayout android:id="@+id/navTools" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/navToolsIcon" android:layout_width="34dp" android:layout_height="34dp" android:importantForAccessibility="no" android:padding="6dp" android:src="@drawable/home_ic_tools"/>
                <TextView android:id="@+id/navToolsLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_tools" android:textSize="11sp"/>
            </LinearLayout>
            <!--  Pro (opens the Pro screen on top)  -->
            <LinearLayout android:id="@+id/navPro" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/navProIcon" android:layout_width="34dp" android:layout_height="34dp" android:importantForAccessibility="no" android:padding="6dp" android:src="@drawable/home_ic_crown"/>
                <TextView android:id="@+id/navProLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_pro" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/fabAi" android:layout_width="68dp" android:layout_height="68dp" android:layout_marginStart="10dp" android:background="@drawable/home_bg_fab" android:clickable="true" android:contentDescription="@string/ask_ai" android:elevation="8dp" android:focusable="true" android:padding="20dp" android:src="@drawable/home_ic_sparkle" android:tint="#FFFFFF"/>
    </LinearLayout>
</FrameLayout>