<?xml version="1.0" encoding="utf-8"?>
<!-- Add this inside <resources> in your styles file (or keep this file as is) -->
<resources>
    <style name="HomeLiveBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/home_bg_live_badge</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">2dp</item>
        <item name="android:text">@string/live_badge</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableStart">@drawable/home_ic_live_dot</item>
    </style>
</resources>
